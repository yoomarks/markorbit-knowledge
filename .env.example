# Optional absolute path for the local/self-hosted SQLite Source Registry.
# Defaults to .data/markorbit-knowledge.sqlite under the repository root.
MARKORBIT_KNOWLEDGE_DB_PATH=

# Optional explicit repository root used to resolve the default .data directory.
MARKORBIT_REPOSITORY_ROOT=

# Optional absolute local content-addressed artifact store root
MARKORBIT_ARTIFACT_STORE_PATH=
# Maximum streamed artifact size in bytes (defaults to 104857600)
MARKORBIT_ARTIFACT_MAX_BYTES=

# Optional absolute Verified Staging content-addressed store root.
# Defaults to .data/staging under the repository root.
MARKORBIT_STAGING_STORE_PATH=

# External Worker control-plane connection.
MARKORBIT_CONTROL_PLANE_URL=http://localhost:3000
MARKORBIT_WORKER_ID=
# One-time Worker credential returned by POST /api/workers or bootstrap:uspto.
MARKORBIT_WORKER_CREDENTIAL=
MARKORBIT_WORKER_RUNTIME_VERSION=1.0.0
MARKORBIT_WORKER_POLL_INTERVAL_MS=2000
# Must remain below the control plane's lease/heartbeat expiry window.
MARKORBIT_WORKER_KEEPALIVE_INTERVAL_MS=30000
# Defaults to 12 minutes and is capped at 14 minutes, below the default 15-minute max lease lifetime.
MARKORBIT_WORKER_MAX_COLLECTION_RUNTIME_MS=720000
MARKORBIT_WORKER_ERROR_BACKOFF_MIN_MS=1000
MARKORBIT_WORKER_ERROR_BACKOFF_MAX_MS=30000

# Production Conversion Worker. Disabled by default so existing collection-only deployments remain compatible.
# bootstrap:uspto-conversion prints the Workspace ID and capability revision to use here.
MARKORBIT_CONVERSION_ENABLED=0
MARKORBIT_WORKSPACE_ID=
MARKORBIT_CONVERSION_CAPABILITY_REVISION=1
# Conversion v1 is deterministic Markdown processing; 300 seconds is the default lease duration.
MARKORBIT_CONVERSION_LEASE_DURATION_SECONDS=300

# Production Crawl4AI egress policy. Production Worker refuses REQUIRE_EGRESS_PROXY=0.
MARKORBIT_CRAWL4AI_REQUIRE_EGRESS_PROXY=1
# Example: http://egress-proxy.internal:3128 (credentials should come from secret injection).
MARKORBIT_CRAWL4AI_EGRESS_PROXY=
# Optional overrides; defaults are python3 and workers/crawl4ai/acquire.py.
MARKORBIT_CRAWL4AI_PYTHON=
MARKORBIT_CRAWL4AI_SCRIPT=
