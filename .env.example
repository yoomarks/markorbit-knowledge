# Optional absolute path for the local/self-hosted SQLite Source Registry.
# Defaults to .data/markorbit-knowledge.sqlite under the repository root.
MARKORBIT_KNOWLEDGE_DB_PATH=

# Optional explicit repository root used to resolve the default .data directory.
MARKORBIT_REPOSITORY_ROOT=

# Optional absolute local content-addressed artifact store root
MARKORBIT_ARTIFACT_STORE_PATH=
# Maximum streamed artifact size in bytes (defaults to 104857600)
MARKORBIT_ARTIFACT_MAX_BYTES=

# Optional absolute Verified Staging content-addressed store root.
# Defaults to .data/staging under the repository root.
MARKORBIT_STAGING_STORE_PATH=

# Absolute server-controlled Obsidian/Vault filesystem root.
# Workspace VaultBinding records store only portable relative directories below this root.
# The absolute value is not returned by the admin API.
MARKORBIT_OBSIDIAN_VAULT_ROOT=

# Complete HTTP(S) destination for explicit ReadyPackage Core-intake submission.
# Core's receiver path is /internal/knowledge/ready-packages/intakes.
# Credentials must not be embedded in this URL.
MARKORBIT_CORE_INTAKE_URL=http://127.0.0.1:4101/internal/knowledge/ready-packages/intakes
# Must match the Core service's MO_INTERNAL_SERVICE_SECRET value.
# It is sent only as x-markorbit-internal-authorization and is never persisted.
MARKORBIT_CORE_INTERNAL_SECRET=

# External Worker control-plane connection.
MARKORBIT_CONTROL_PLANE_URL=http://localhost:3000
MARKORBIT_WORKER_ID=
# One-time Worker credential returned by POST /api/workers or a bootstrap command.
MARKORBIT_WORKER_CREDENTIAL=
MARKORBIT_WORKER_RUNTIME_VERSION=1.0.0
MARKORBIT_WORKER_POLL_INTERVAL_MS=2000
# Must remain below the control plane's lease/heartbeat expiry window.
MARKORBIT_WORKER_KEEPALIVE_INTERVAL_MS=30000
# Defaults to 12 minutes and is capped at 14 minutes, below the default 15-minute max lease lifetime.
MARKORBIT_WORKER_MAX_COLLECTION_RUNTIME_MS=720000
MARKORBIT_WORKER_ERROR_BACKOFF_MIN_MS=1000
MARKORBIT_WORKER_ERROR_BACKOFF_MAX_MS=30000

# Collection provider for this Worker process: crawl4ai (default), local-folder, or api.
MARKORBIT_COLLECTION_PROVIDER=crawl4ai

# Production Local Folder Worker. Absolute roots exist only in the Worker environment and are never persisted
# in SourceDefinition. Example on Linux/macOS:
# MARKORBIT_LOCAL_FOLDER_ROOTS={"legal":"/srv/markorbit/legal","research":"/srv/markorbit/research"}
# Example on Windows (JSON escaping required):
# MARKORBIT_LOCAL_FOLDER_ROOTS={"legal":"D:\\MarkOrbit\\Legal"}
MARKORBIT_LOCAL_FOLDER_ROOTS=
# Used by bootstrap:local-folder to choose one alias from MARKORBIT_LOCAL_FOLDER_ROOTS.
MARKORBIT_LOCAL_FOLDER_ROOT_ID=
# Portable forward-slash path under the chosen root. Empty means the root itself.
MARKORBIT_LOCAL_FOLDER_RELATIVE_PATH=
MARKORBIT_LOCAL_FOLDER_SOURCE_NAME=
MARKORBIT_LOCAL_FOLDER_RECURSIVE=1
MARKORBIT_LOCAL_FOLDER_INCLUDE_HIDDEN=0
MARKORBIT_LOCAL_FOLDER_PLAN_MAX_DEPTH=8
MARKORBIT_LOCAL_FOLDER_PLAN_MAX_ITEMS=250
# Worker hard limits; the immutable CollectionPlan must stay within these bounds.
MARKORBIT_LOCAL_FOLDER_MAX_ARTIFACT_BYTES=26214400
MARKORBIT_LOCAL_FOLDER_MAX_TOTAL_BYTES=104857600
MARKORBIT_LOCAL_FOLDER_MAX_ITEMS=500
MARKORBIT_LOCAL_FOLDER_MAX_DEPTH=20

# Production governed HTTPS API Worker. The endpoint origin and auth indirection stay only on the Worker.
# Example (do not commit real credentials):
# MARKORBIT_API_ENDPOINT_BINDINGS={"public-api":{"baseUrl":"https://api.example.com","auth":{"kind":"BEARER","secretEnv":"EXAMPLE_API_TOKEN"}}}
# EXAMPLE_API_TOKEN=runtime-secret
MARKORBIT_API_ENDPOINT_BINDINGS=
# Bootstrap selects one logical binding and persists only the binding id/path/non-secret query configuration.
MARKORBIT_API_ENDPOINT_BINDING=
MARKORBIT_API_RESOURCE_PATH=
MARKORBIT_API_QUERY_JSON=
MARKORBIT_API_SOURCE_NAME=
MARKORBIT_API_TIMEOUT_MS=30000
MARKORBIT_API_MAX_RESPONSE_BYTES=10485760

# Production Conversion Worker. Disabled by default so existing collection-only deployments remain compatible.
# bootstrap:uspto-conversion prints the Workspace ID and capability revision to use here.
MARKORBIT_CONVERSION_ENABLED=0
MARKORBIT_WORKSPACE_ID=
MARKORBIT_CONVERSION_CAPABILITY_REVISION=1
# Conversion v1 is deterministic Markdown processing; 300 seconds is the default lease duration.
MARKORBIT_CONVERSION_LEASE_DURATION_SECONDS=300

# Production Crawl4AI egress policy. A production crawl4ai Worker refuses REQUIRE_EGRESS_PROXY=0.
MARKORBIT_CRAWL4AI_REQUIRE_EGRESS_PROXY=1
# Example: http://egress-proxy.internal:3128 (credentials should come from secret injection).
MARKORBIT_CRAWL4AI_EGRESS_PROXY=
# Optional overrides; defaults are python3 and workers/crawl4ai/acquire.py.
MARKORBIT_CRAWL4AI_PYTHON=
MARKORBIT_CRAWL4AI_SCRIPT=
