{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.markorbit.dev/knowledge/v1/source-definition.schema.json",
  "title": "SourceDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "objectType",
    "id",
    "workspaceId",
    "name",
    "slug",
    "sourceType",
    "category",
    "authorityLevel",
    "status",
    "jurisdictions",
    "languages",
    "connector",
    "connectorConfig",
    "entrypoints",
    "tags",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "objectType": { "const": "SOURCE_DEFINITION" },
    "id": { "$ref": "common.schema.json#/$defs/sourceId" },
    "workspaceId": { "$ref": "common.schema.json#/$defs/workspaceId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 240 },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "sourceType": { "$ref": "common.schema.json#/$defs/sourceType" },
    "category": {
      "enum": [
        "OFFICIAL_AUTHORITY",
        "OFFICIAL_GUIDANCE",
        "LAW_FIRM",
        "NEWS",
        "RESEARCH",
        "TECHNICAL",
        "INTERNAL",
        "USER_PROVIDED",
        "OTHER"
      ]
    },
    "authorityLevel": {
      "enum": [
        "PRIMARY_OFFICIAL",
        "SECONDARY_OFFICIAL",
        "PROFESSIONAL",
        "INDUSTRY",
        "COMMUNITY",
        "INTERNAL",
        "UNKNOWN"
      ]
    },
    "status": { "$ref": "common.schema.json#/$defs/sourceStatus" },
    "jurisdictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,15}$" }
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/locale" }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectorId", "version"],
      "properties": {
        "connectorId": { "$ref": "common.schema.json#/$defs/connectorId" },
        "version": { "$ref": "common.schema.json#/$defs/semver" }
      }
    },
    "connectorConfig": {
      "type": "object",
      "description": "Non-secret declarative connector configuration. Credentials must be represented only by secretRef."
    },
    "secretRef": { "$ref": "common.schema.json#/$defs/secretRef" },
    "canonicalUri": { "$ref": "common.schema.json#/$defs/uri" },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri"],
        "properties": {
          "uri": { "$ref": "common.schema.json#/$defs/uri" },
          "label": { "type": "string", "maxLength": 160 }
        }
      }
    },
    "defaultCollectionPlanId": { "$ref": "common.schema.json#/$defs/planId" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
